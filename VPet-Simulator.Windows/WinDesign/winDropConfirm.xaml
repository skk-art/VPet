<pu:WindowX x:Class="VPet_Simulator.Windows.winDropConfirm" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI" xmlns:local="clr-namespace:VPet_Simulator.Windows"
        Title="删除确认" Width="520" Height="420" WindowStartupLocation="CenterScreen"
        mc:Ignorable="d" Background="{DynamicResource DARKPrimaryText}" FontSize="14" MinWidth="420" MinHeight="320">
    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="🗑 要彻底删除这些吗?" FontWeight="Bold" FontSize="18"
                Foreground="{DynamicResource DARKPrimary}" Margin="0,0,0,6" />
        <TextBlock x:Name="TxtWarn" Grid.Row="1" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#FFD24545"
                Text="以下内容将被永久删除 (不经过回收站, 无法恢复):" />
        <Border Grid.Row="2" BorderBrush="{DynamicResource DARKPrimaryDarker}" BorderThickness="1" CornerRadius="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SpItems" Margin="10,8" />
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="取消" Padding="22,7" Margin="0,0,10,0" Cursor="Hand"
                    pu:ButtonHelper.CornerRadius="5" Click="BtnCancel_Click" />
            <Button Grid.Column="2" Content="彻底删除" Padding="22,7" Cursor="Hand" Background="#FFD24545"
                    Foreground="White" pu:ButtonHelper.CornerRadius="5" Click="BtnDelete_Click" />
        </Grid>
    </Grid>
</pu:WindowX>
