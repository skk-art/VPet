<UserControl x:Class="VPet_Simulator.Core.BubbleMenu" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
        xmlns:local="clr-namespace:VPet_Simulator.Core" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pu="https://opensource.panuon.com/wpf-ui" Width="500" Height="500" VerticalAlignment="Top"
        Background="{x:Null}" MouseEnter="UserControl_MouseEnter" MouseLeave="UserControl_MouseLeave"
        mc:Ignorable="d">
    <!--
        右键气泡式交互菜单: 右键桌宠时, 在桌宠周围弹出四个聊天气泡 (投喂/面板/互动/系统)
        点击气泡执行对应功能; 气泡带弹出/收起动画, 超时或鼠标离开自动关闭
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="BubbleBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource DARKPrimaryText}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DARKPrimaryDarker}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="pu:ShadowHelper.Opacity" Value="0.5" />
                <Setter Property="pu:ShadowHelper.BlurRadius" Value="14" />
                <Setter Property="pu:ShadowHelper.ShadowDepth" Value="5" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style x:Key="BubbleText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource DARKPrimary}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="BubbleIcon" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="MainGrid" Background="{x:Null}">
        <!-- 投喂: 头部左上 -->
        <Grid x:Name="BubFeed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,45,0,0"
                RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" MouseLeftButtonUp="BubFeed_Click">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource BubbleBorderStyle}" Padding="14,7">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BubbleIcon}" Text="🍖" />
                        <TextBlock Style="{StaticResource BubbleText}" Text="{ll:Str 投喂}" />
                    </StackPanel>
                </Border>
                <Polygon Fill="{DynamicResource DARKPrimaryText}" Points="0,14 12,22 0,30" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <!-- 面板: 头部右上 -->
        <Grid x:Name="BubPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,45,5,0"
                RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" MouseLeftButtonUp="BubPanel_Click">
            <StackPanel Orientation="Horizontal">
                <Polygon Fill="{DynamicResource DARKPrimaryText}" Points="12,14 0,22 12,30" VerticalAlignment="Center" />
                <Border Style="{StaticResource BubbleBorderStyle}" Padding="14,7">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BubbleIcon}" Text="📊" />
                        <TextBlock Style="{StaticResource BubbleText}" Text="{ll:Str 面板}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        <!-- 互动: 腰部左侧 -->
        <Grid x:Name="BubInteract" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,215,0,0"
                RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" MouseLeftButtonUp="BubInteract_Click">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource BubbleBorderStyle}" Padding="14,7">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BubbleIcon}" Text="🎮" />
                        <TextBlock Style="{StaticResource BubbleText}" Text="{ll:Str 互动}" />
                    </StackPanel>
                </Border>
                <Polygon Fill="{DynamicResource DARKPrimaryText}" Points="0,14 12,22 0,30" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <!-- 系统: 腰部右侧 -->
        <Grid x:Name="BubSetting" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,215,5,0"
                RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" MouseLeftButtonUp="BubSetting_Click">
            <StackPanel Orientation="Horizontal">
                <Polygon Fill="{DynamicResource DARKPrimaryText}" Points="12,14 0,22 12,30" VerticalAlignment="Center" />
                <Border Style="{StaticResource BubbleBorderStyle}" Padding="14,7">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BubbleIcon}" Text="⚙" />
                        <TextBlock Style="{StaticResource BubbleText}" Text="{ll:Str 系统}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        <!-- 自定: 仅当MOD/插件注册了自定按钮时显示, 头部正上方 -->
        <Grid x:Name="BubDIY" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" MouseLeftButtonUp="BubDIY_Click">
            <StackPanel Orientation="Vertical">
                <Border Style="{StaticResource BubbleBorderStyle}" Padding="14,7">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BubbleIcon}" Text="✨" />
                        <TextBlock Style="{StaticResource BubbleText}" Text="{ll:Str 自定}" />
                    </StackPanel>
                </Border>
                <Polygon Fill="{DynamicResource DARKPrimaryText}" HorizontalAlignment="Center" Points="0,0 12,0 6,10" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
