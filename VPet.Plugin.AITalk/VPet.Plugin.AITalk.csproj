<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows7.0</TargetFramework>
		<OutputType>Library</OutputType>
		<RootNamespace>VPet.Plugin.AITalk</RootNamespace>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<Version>1.0.0</Version>
		<Authors>skk-art</Authors>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\VPet-Simulator.Windows.Interface\VPet-Simulator.Windows.Interface.csproj" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="LinePutScript" Version="1.11.9" />
		<PackageReference Include="LinePutScript.Localization.WPF" Version="1.0.7" />
		<PackageReference Include="Panuon.WPF" Version="1.1.3" />
		<PackageReference Include="Panuon.WPF.UI" Version="1.2.4.10" />
		<PackageReference Include="System.Speech" Version="8.0.0" />
	</ItemGroup>
	<ItemGroup>
		<None Update="info.lps">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<!-- 构建后自动把插件部署到 VPet-Simulator.Windows 的 mod 目录 (调试即用) -->
	<Target Name="DeployToMod" AfterTargets="Build" Condition="'$(Configuration)'=='Debug'">
		<PropertyGroup>
			<ModDir>$(MSBuildThisFileDirectory)..\VPet-Simulator.Windows\mod\1112_AITalk\plugin\</ModDir>
			<SpeechDll>$(NuGetPackageRoot)system.speech/8.0.0/runtimes/win/lib/net8.0/System.Speech.dll</SpeechDll>
		</PropertyGroup>
		<Message Importance="high" Text="DeployToMod: $(TargetPath) -> $(ModDir)" />
		<MakeDir Directories="$(ModDir)" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDir)" SkipUnchangedFiles="true" />
		<!-- 语音识别依赖 (System.Speech 为 RID 特定包, 无RID构建时需手动部署) -->
		<Copy SourceFiles="$(SpeechDll)" DestinationFolder="$(ModDir)" SkipUnchangedFiles="true" Condition="Exists('$(SpeechDll)')" />
	</Target>
</Project>
