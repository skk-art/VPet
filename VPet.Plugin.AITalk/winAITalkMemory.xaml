<pu:WindowX x:Class="VPet.Plugin.AITalk.winAITalkMemory" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI" xmlns:local="clr-namespace:VPet.Plugin.AITalk"
        Title="记忆与知识库" Width="640" Height="640" WindowStartupLocation="CenterScreen"
        mc:Ignorable="d" Background="{DynamicResource DARKPrimaryText}" FontSize="14" MinWidth="560" MinHeight="520">
    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="🧠 记忆与知识库" FontWeight="Bold" FontSize="18"
                    Foreground="{DynamicResource DARKPrimary}" />
            <TextBlock x:Name="TxtSummary" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.85"
                    Foreground="{DynamicResource DARKPrimary}" />
        </StackPanel>
        <TabControl x:Name="Tabs" Grid.Row="1" Background="{x:Null}" BorderThickness="0">
            <TabItem Header="关于我 · 知识库">
                <Grid Margin="4,8,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="在这里写下想让桌宠知道的信息 (个人信息 / 喜好 / 习惯 / 工作 / 作息…), 每次聊天它都会看到:" 
                            TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,6"
                            Foreground="{DynamicResource DARKPrimary}" />
                    <TextBox x:Name="TbProfile" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" Padding="8,6" pu:TextBoxHelper.CornerRadius="5"
                            pu:TextBoxHelper.Watermark="例如:&#10;我叫小明, 是一名程序员&#10;喜欢喝冰美式, 不加糖&#10;每天 23:00 前睡觉&#10;正在学吉他" />
                    <Button x:Name="BtnSaveProfile" Grid.Row="2" Content="保存知识库" Padding="20,7" Margin="0,8,0,0"
                            HorizontalAlignment="Right" Cursor="Hand" Style="{DynamicResource ThemedButtonStyle}"
                            pu:ButtonHelper.CornerRadius="5" Click="BtnSaveProfile_Click" />
                </Grid>
            </TabItem>
            <TabItem Header="长期记忆">
                <Grid Margin="4,8,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="桌宠会在每次聊天后自动学习关于你的新信息存到这里 (也可手动添加/删除):"
                            TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,6"
                            Foreground="{DynamicResource DARKPrimary}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SpMemories" />
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TbNewMemory" Padding="6,5" pu:TextBoxHelper.CornerRadius="5"
                                pu:TextBoxHelper.Watermark="手动添加一条记忆, 回车保存" KeyDown="TbNewMemory_KeyDown" />
                        <Button Grid.Column="1" Content="添加" Padding="16,6" Margin="8,0,0,0" Cursor="Hand"
                                pu:ButtonHelper.CornerRadius="5" Style="{DynamicResource ThemedButtonStyle}" Click="BtnAdd_Click" />
                        <Button Grid.Column="2" Content="清空全部" Padding="14,6" Margin="8,0,0,0" Cursor="Hand"
                                pu:ButtonHelper.CornerRadius="5" Click="BtnClear_Click" ToolTip="清空全部自动/手动记忆 (知识库不受影响)" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="TxtFoot" Grid.Row="2" Margin="0,8,0,0" FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                Foreground="{DynamicResource DARKPrimary}"
                Text="数据保存在 MOD 目录: AI_Knowledge.txt (知识库) / AI_Memories.json (记忆) / AI_ChatLog.txt (聊天记录)" />
    </Grid>
</pu:WindowX>
